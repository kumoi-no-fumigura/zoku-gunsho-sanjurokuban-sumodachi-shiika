 "blocks": [
  {
   "id": "zoku-gunsho-sanjurokuban-sumodachi-shiika-0001",
   "pid": "nao-734093",
   "pages": [
    1
   ],
   "text": "三十六番相撲立詩歌一番左鱗介悉逢春諸蟄驚雷応放戸蟠龍出凍欲遷雲右餘寒空ばなをかすみもやらす風冴て雪気にくもる春の夜の月二番左春過野村偸折花枝帰我宅恐猶鶯舌語他人右花",
   "poems": [
    "1"
   ]
  },
  {
   "id": "zoku-gunsho-sanjurokuban-sumodachi-shiika-0002",
   "pid": "nao-734093",
   "pages": [
    2
   ],
   "text": "春はみなおなしさてになりはてゝ雲うそかゝれみよし野の山三番左春詞鳥声払地知堂柳花色満山辨遠松右花花はみなかすみのそこに移ひて雲に炙つく小泊瀬の山四番左花下醉吟林逕枕琴花下臥池塘閣蓋水辺眠右けふこすは庭にやあとのいとはれんとへかし人の花の盛を五番左女御入内屏風詩曲水宴花色魏年春暮月水声周且昔余流右春曙みぬよきておもひのこさぬ詠より昔にかずむ春の明ほの六番左暮春於平等院即事羽爵宴遇花漸老翠花跡旧草空春右残春",
   "poems": [
    "2",
    "3",
    "4",
    "5"
   ]
  },
  {
   "id": "zoku-gunsho-sanjurokuban-sumodachi-shiika-0003",
   "pid": "nao-734093",
   "pages": [
    3
   ],
   "text": "よしの山花のふる郷跡たへてむなしき枝に春風そ吹七番夏立山路暁行残月有江楼晩望片雲元右舟中夏月夏の夜をやかてあかしのかち枕浪にかたふく月をしそ思ふ八番左夏日水行斜陽遇雨沙村懈茂草偃風水岸晴右蝉なくせみのはにをく露に秋かけて木陰涼しき夕暮の色九番秋左早秋野亭見草露先白山館聞松風始西右秋夕物おもはてかゝる露やは袖にをくながめさけりな秋の夕暮十番左己遇再宿乕責夢猶隔四朝牛女情右",
   "poems": [
    "6",
    "7",
    "8",
    "9"
   ]
  },
  {
   "id": "zoku-gunsho-sanjurokuban-sumodachi-shiika-0004",
   "pid": "nao-734093",
   "pages": [
    4
   ],
   "text": "真木の戸をさてあり明に成行をいく夜の月ととふ人もなし十一番左女御入内屛風詩秋夜旅泊赴訪隣船江月白臥恩前路海風寒右同屏風歌合坂関駒迎東よりけふあふ坂の関こえてみやこに出る望月の駒は十二番左秋思入湖山波月嶺雲知己旧池魚籠鳥與吾俱右鹿たくへくる松のあらしやたゆむらんおのへにかへる棹鹿の聲十三番左詩家秋色冨香山雲物自然得彭沢風光孫後貽右秋月山とをき門田のいなは霧晴てほなみにしつむ有明の月十四番左九月十三夜月下言志天地気晴迷昼夜林襲苑白照春秋右月",
   "poems": [
    "10",
    "11",
    "12",
    "13"
   ]
  },
  {
   "id": "zoku-gunsho-sanjurokuban-sumodachi-shiika-0005",
   "pid": "nao-734093",
   "pages": [
    5
   ],
   "text": "さらぬたにふくるはおしき秋の夜の月より西に残るしらず十五番左秋荒陰竹風生暁枕深宮槐雨滴秋階右写うつの山こへし昔の跡古くつたの枯葉に秋風そ吹十六番立秋霜催礎杵村声急露湿衣裳山気来右暮秋しけき野は虫の音なから霜枯て昔の薄いまも一村十七番冬左初冬棕巌叟採薪林有月村民収採野元雲右初冬月やとす露の夜すから秋暮て堂のみし庭はかれのなりけり十八番左冬嵐似鄭公溪北路雪同袁氏汝南心右冬",
   "poems": [
    "14",
    "15",
    "16"
   ]
  },
  {
   "id": "zoku-gunsho-sanjurokuban-sumodachi-shiika-0006",
   "pid": "nao-734093",
   "pages": [
    6
   ],
   "text": "さひしきはいつもなかめの物なれと雲間の峯の雪の曙十九番左雪中山居地炉火滅柴枝温雲碓氷凝薬杵閑右冬朝雲ふかきみねの朝気のいかならん槙の戸しらむ雪のひかりに雑廿番左山家欲買閑山雲管領試求隙地草羅生右山家麓まておなしさゝ原跡もなし深山の廬の露のしたへ廿一番〃左山家古松夜雨幽渓涙蔵菅秋風荒巷情右山家瀧の音松のひゝきもはけしきにつれなくあかす岩枕哉廿二番立山家獲鳥豈伝時俗語烟嵐不記故人心右旧宅",
   "poems": [
    "17",
    "18",
    "19",
    "20"
   ]
  },
  {
   "id": "zoku-gunsho-sanjurokuban-sumodachi-shiika-0007",
   "pid": "nao-734093",
   "pages": [
    7
   ],
   "text": "古郷は浅茅か末に成はてゝ月にのこれる人のおもかけ廿三番左山寺耳界厭喧風一樹頭陀照跡月千巌右花あはれなる花のこかけの旅ねかなみねの桜の衣かさねて廿四番左於天王寺即事堂宇有面今見昔海湖元岸水連雲右於住吉社即事宮ゐせしとしもつもりのうらさひて神代おほゆる松の陰哉廿五番左秋遊山寺月輪水上空観主風葉山中独覚師右緑覚おく山にひとりうき世はさとりにきつねなき色を風になかめて廿六番左秋夜旅泊山重江復煙嵐路寐思窮思来梓郷右海路秋望",
   "poems": [
    "21",
    "22",
    "23",
    "24"
   ]
  },
  {
   "id": "zoku-gunsho-sanjurokuban-sumodachi-shiika-0008",
   "pid": "nao-734093",
   "pages": [
    8
   ],
   "text": "ゆく舟の跡のしら浪きえつきてうす霧のこる須磨の曙廿七番左旅剣閣梯危迷霧雨銭塘舟到宿烟嵐右きよみかた波の千里に雲きえていはしく袖によする月かけ廿八番左旅江山千里他郷涙雲雨三年旅舘膓一右海辺暁月忘るなよいまはの月をかたみにて波にわかるく沖の明ふね廿九番左夏日水行渡口停船山不動湖心求泊嶋相迎右於漢河原詠之むかしきくあまの川原に尋きて跡なき水をなかむはかりそ三十番左述懐生涯不返水元意仏界非遥月在胸右別恋",
   "poems": [
    "25",
    "26",
    "27"
   ]
  },
  {
   "id": "zoku-gunsho-sanjurokuban-sumodachi-shiika-0009",
   "pid": "nao-734093",
   "pages": [
    9
   ],
   "text": "一わすれしの契をたのむ別かな空ゆく月の末をよそへて三十一番左述懐日々悔遇最白仏時々歎運仰蒼天右恋泪せく袖におもひやあまるらん詠むる空も色かわるまて三十二番左病中偶吟病源河海朝窓水命葉芭蕉秋後風右待意よもきふの末葉の露のきえかへりなをこの世にとまたんものかは三十三番左病中偶吟三界元安皆火宅一生有限幾風燈右意吹風も物や思ふととひかほにうちなかむれはまつの一聲三十四番左病中偶吟来迎漏誓弥陀仏罪障裏縁那落迦右夜忠",
   "poems": [
    "28",
    "29",
    "30",
    "31"
   ]
  },
  {
   "id": "zoku-gunsho-sanjurokuban-sumodachi-shiika-0010",
   "pid": "nao-734093",
   "pages": [
    10
   ],
   "text": "見し人のねくたれかみのをもかけに泪かさやるさよの手枕三十五番左春過長秋納言旧宅花尚春花留有露宅斯旧宅廢無人右述懐うつまれぬのちの名さへやとめさらんなすことなくてこのよくれなは三十六番左出現於世雲章満月重山夕浪発曇花苦海春右寄元動寺座主なかき夜の更行月を詠てもちかつくやみをしる人そなき奥書云世尊寺先祖号勘解小路三位後改此一巻白川二品経甲卿男経定ニ筆可秘伊朝蔵云々",
   "poems": [
    "32",
    "33",
    "34"
   ]
  }
 ],
 "poems": [
  {
   "seq": "1",
   "text": "空ばなをかすみもやらす風冴て雪気にくもる春の夜の月",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "一",
   "side": "右",
   "dai": "餘寒"
  },
  {
   "seq": "2",
   "text": "春はみなおなしさてになりはてゝ雲うそかゝれみよし野の山",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "二",
   "side": "右",
   "dai": "花"
  },
  {
   "seq": "3",
   "text": "花はみなかすみのそこに移ひて雲に炙つく小泊瀬の山",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "三",
   "side": "右",
   "dai": "花"
  },
  {
   "seq": "4",
   "text": "けふこすは庭にやあとのいとはれんとへかし人の花の盛を",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "四",
   "side": "右",
   "dai": "花下醉吟"
  },
  {
   "seq": "5",
   "text": "みぬよきておもひのこさぬ詠より昔にかずむ春の明ほの",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "五",
   "side": "右",
   "dai": "春曙"
  },
  {
   "seq": "6",
   "text": "よしの山花のふる郷跡たへてむなしき枝に春風そ吹",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "六",
   "side": "右",
   "dai": "残春"
  },
  {
   "seq": "7",
   "text": "夏の夜をやかてあかしのかち枕浪にかたふく月をしそ思ふ",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "七",
   "side": "右",
   "dai": "舟中夏月"
  },
  {
   "seq": "8",
   "text": "なくせみのはにをく露に秋かけて木陰涼しき夕暮の色",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "八",
   "side": "右",
   "dai": "蝉"
  },
  {
   "seq": "9",
   "text": "物おもはてかゝる露やは袖にをくながめさけりな秋の夕暮",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "九",
   "side": "右",
   "dai": "秋夕"
  },
  {
   "seq": "10",
   "text": "真木の戸をさてあり明に成行をいく夜の月ととふ人もなし",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "十",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "11",
   "text": "東よりけふあふ坂の関こえてみやこに出る望月の駒は",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "十一",
   "side": "",
   "dai": ""
  },
  {
   "seq": "12",
   "text": "たくへくる松のあらしやたゆむらんおのへにかへる棹鹿の聲",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "十二",
   "side": "右",
   "dai": "鹿"
  },
  {
   "seq": "13",
   "text": "山とをき門田のいなは霧晴てほなみにしつむ有明の月",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "十三",
   "side": "右",
   "dai": "秋月"
  },
  {
   "seq": "14",
   "text": "うつの山こへし昔の跡古くつたの枯葉に秋風そ吹",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "十五",
   "side": "右",
   "dai": "写"
  },
  {
   "seq": "15",
   "text": "しけき野は虫の音なから霜枯て昔の薄いまも一村",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "十六",
   "side": "右",
   "dai": "暮秋"
  },
  {
   "seq": "16",
   "text": "月やとす露の夜すから秋暮て堂のみし庭はかれのなりけり",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "十七",
   "side": "右",
   "dai": "初冬"
  },
  {
   "seq": "17",
   "text": "さひしきはいつもなかめの物なれと雲間の峯の雪の曙",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "十八",
   "side": "右",
   "dai": "冬"
  },
  {
   "seq": "18",
   "text": "雲ふかきみねの朝気のいかならん槙の戸しらむ雪のひかりに",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "十九",
   "side": "右",
   "dai": "冬朝"
  },
  {
   "seq": "19",
   "text": "麓まておなしさゝ原跡もなし深山の廬の露のしたへ",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "廿",
   "side": "右",
   "dai": "山家"
  },
  {
   "seq": "20",
   "text": "瀧の音松のひゝきもはけしきにつれなくあかす岩枕哉",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "廿一",
   "side": "右",
   "dai": "山家"
  },
  {
   "seq": "21",
   "text": "古郷は浅茅か末に成はてゝ月にのこれる人のおもかけ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "廿二",
   "side": "右",
   "dai": "旧宅"
  },
  {
   "seq": "22",
   "text": "あはれなる花のこかけの旅ねかなみねの桜の衣かさねて",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "廿三",
   "side": "右",
   "dai": "花"
  },
  {
   "seq": "23",
   "text": "宮ゐせしとしもつもりのうらさひて神代おほゆる松の陰哉",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "廿四",
   "side": "右",
   "dai": "於住吉社即事"
  },
  {
   "seq": "24",
   "text": "おく山にひとりうき世はさとりにきつねなき色を風になかめて",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "廿五",
   "side": "右",
   "dai": "緑覚"
  },
  {
   "seq": "25",
   "text": "きよみかた波の千里に雲きえていはしく袖によする月かけ",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "廿七",
   "side": "右",
   "dai": "旅"
  },
  {
   "seq": "26",
   "text": "忘るなよいまはの月をかたみにて波にわかるく沖の明ふね",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "廿八",
   "side": "右",
   "dai": "海辺暁月"
  },
  {
   "seq": "27",
   "text": "むかしきくあまの川原に尋きて跡なき水をなかむはかりそ",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "廿九",
   "side": "右",
   "dai": "於漢河原詠之"
  },
  {
   "seq": "28",
   "text": "一わすれしの契をたのむ別かな空ゆく月の末をよそへて",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "三十",
   "side": "右",
   "dai": "別恋"
  },
  {
   "seq": "29",
   "text": "泪せく袖におもひやあまるらん詠むる空も色かわるまて",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "三十一",
   "side": "右",
   "dai": "恋"
  },
  {
   "seq": "30",
   "text": "よもきふの末葉の露のきえかへりなをこの世にとまたんものかは",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "三十二",
   "side": "右",
   "dai": "待意"
  },
  {
   "seq": "31",
   "text": "吹風も物や思ふととひかほにうちなかむれはまつの一聲",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "三十三",
   "side": "右",
   "dai": "意"
  },
  {
   "seq": "32",
   "text": "見し人のねくたれかみのをもかけに泪かさやるさよの手枕",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "三十四",
   "side": "右",
   "dai": "夜忠"
  },
  {
   "seq": "33",
   "text": "うつまれぬのちの名さへやとめさらんなすことなくてこのよくれなは",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "三十五",
   "side": "右",
   "dai": "述懐"
  },
  {
   "seq": "34",
   "text": "なかき夜の更行月を詠てもちかつくやみをしる人そなき",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "三十六",
   "side": "右",
   "dai": "寄元動寺座主"
  }
