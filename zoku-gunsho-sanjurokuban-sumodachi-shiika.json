 "blocks": [
  {
   "id": "zoku-gunsho-sanjurokuban-sumodachi-shiika-0001",
   "pid": "nao-734093",
   "pages": [
    1
   ],
   "text": "三十六番相撲立詩歌一番春左鱗介悉逢春諸蟄驚雷應啓戸蟠龍出凍欲遷雲右餘寒空ばなをかすみもやらす風冴て雪氣ふくもる春の夜の月二番左春過野村偸折花枝歸我宅恐猶鶯舌語他人右花",
   "poems": [
    "1"
   ],
   "kakikudashi": "諸蟄雷に驚きて応に戸を啓くべし、蟠龍凍を出でて雲に遷らんと欲す\n野村を過ぎて偸かに花枝を折りて我が宅に帰る、恐らくは猶鶯舌他人に語らん"
  },
  {
   "id": "zoku-gunsho-sanjurokuban-sumodachi-shiika-0002",
   "pid": "nao-734093",
   "pages": [
    2
   ],
   "text": "春はみなおなしさてになりはてゝ雲うそかゝれみよし野の山三番左春詞鳥聲拂地知堂柳花色滿山辨遠松右花花はみなかすみのそこに移ひて雲に炙つく小泊瀬の山四番左花下醉吟林逕枕琴花下臥池塘閑盡水邊眠右けふこすは庭にやあとのいとはれんとへかし人の花の盛を五番左女御入内屏風詩曲水宴花色魏年春暮月水聲周旦昔餘流右春曙みぬよきておもひのこさぬ詠より昔にかずむ春の明ほの六番左暮春於平等院即事羽離宮遇花漸老翠花跡舊草空春右殘春",
   "poems": [
    "2",
    "3",
    "4",
    "5"
   ],
   "kakikudashi": "林逕琴を枕として花下に臥し、池塘閑かに尽きて水辺に眠る\n花色魏年春暮の月、水声周旦昔余の流れ\n羽離宮花に遇ひて漸く老い、翠花跡旧りて草空しく春なり"
  },
  {
   "id": "zoku-gunsho-sanjurokuban-sumodachi-shiika-0003",
   "pid": "nao-734093",
   "pages": [
    3
   ],
   "text": "よしの山花のふる郷跡たへてむなしき枝に春風そ吹七番夏左山路暁行残月有江樓晩望片雲无右舟中夏月夏の夜をやかてあかしのかち枕浪にかたふく月をしそ思ふ八番左夏日水行斜陽過雨沙村解茂草偃風水岸晴右蝉なくせみのはにをく露に秋かけて木陰涼しき夕暮の色九番秋左早秋野亭見草露先白山館聞松風始西右秋夕物おもはてかゝる露やは袖にをくながめさけりな秋の夕暮十番左已過再宿席責夢猶隔四朝牛女情右",
   "poems": [
    "6",
    "7",
    "8",
    "9"
   ],
   "kakikudashi": "斜陽雨過ぎて沙村解け、茂草風に偃して水岸晴る\n野亭草を見れば露先づ白く、山館松を聞けば風始めて西す\n已に再宿を過ぎて席夢を責む、猶隔つ四朝牛女の情"
  },
  {
   "id": "zoku-gunsho-sanjurokuban-sumodachi-shiika-0004",
   "pid": "nao-734093",
   "pages": [
    4
   ],
   "text": "真木の戸をさてあり明に成行をいく夜の月ととふ人もなし十一番左女御入内屛風詩秋夜旅泊赴訪隣船江月白臥思前路海風寒右同屏風歌合坂関駒迎東よりけふあふ坂の関こえてみやこに出る望月の駒十二番左秋思入湖山波月嶺雲知己舊池魚籠鳥與吾俱右鹿たくへくる松のあらしやたゆむらんおのへにかへる棹鹿の聲十三番左詩家秋色冨香山雲物自然得彭澤風光孫後貽右秋月山とをき門田のいなは霧晴てほなみにしつむ有明の月十四番左九月十三夜月下言志天地氣暗迷畫夜林叢苑白照春秋右月",
   "poems": [
    "10",
    "11",
    "12",
    "13"
   ],
   "kakikudashi": "訪ひに赴く隣船江月白し、臥して前路を思へば海風寒し\n湖山に入れば波月嶺雲己を知ること旧し、池魚籠鳥吾と倶にす\n冨香山の雲物自然に得たり、彭沢の風光孫後に貽す\n天地気暗くして昼夜に迷ひ、林叢苑白くして春秋を照らす"
  },
  {
   "id": "zoku-gunsho-sanjurokuban-sumodachi-shiika-0005",
   "pid": "nao-734093",
   "pages": [
    5
   ],
   "text": "さらぬたにふくるはおしき秋の夜の月より西に残るしら雪十五番左秋荒陰竹風生暁枕深宮槐雨滴秋階右写うつの山こへし昔の跡古くつたの枯葉に秋風そ吹十六番左秋霜催礎杵村声急露湿衣裳山気来右暮秋𛁈けき野は虫の音なから霜枯て昔の薄いまも一村十七番冬左初冬巖叟採薪林有月村民収採野元雲右初冬月やとす露の夜すから秋暮て堂のみし庭はかれのなりけり十八番左冬嵐似鄭公溪北路雪同袁氏汝南心右冬",
   "poems": [
    "14",
    "15",
    "16"
   ],
   "notes": [
    {
     "a": "収採",
     "n": "掠イ",
     "k": "校異"
    }
   ],
   "kakikudashi": "荒陰の竹風暁枕に生じ、深宮の槐雨秋階に滴る\n霜は礎杵を催して村声急に、露は衣裳を湿して山気来たる\n巌叟薪を採れば林に月有り、村民収め採れば野に元雲\n嵐は鄭公渓北の路に似、雪は袁氏汝南の心に同じ"
  },
  {
   "id": "zoku-gunsho-sanjurokuban-sumodachi-shiika-0006",
   "pid": "nao-734093",
   "pages": [
    6
   ],
   "text": "さひしきはいつもなかめの物なれと雲間の峯の雪の曙十九番左雪中山居地爐火滅柴枝濕雲碓水凝藥杵閑右冬朝雲ふかきみねの朝気のいかならん槙の戸しらむ雪のひかりに廿番雑左山家欲買閑山雲管領試求隙地草羅生右山家麓まておなしさゝ原跡もなし深山の廬の露のしたへ廿一番左山家古松夜雨幽溪涙藏薜秋風荒巷情右山家瀧の音松のひゝきもはけしきにつれなくあかす岩枕哉廿二番左山家獲鳥豈傳時俗語烟嵐不記故人心右旧宅",
   "poems": [
    "17",
    "18",
    "19",
    "20"
   ],
   "kakikudashi": "閑山を買はんと欲すれば雲管領す、試みに隙地を求むれば草羅生す\n古松の夜雨幽渓の涙、蔵薜の秋風荒巷の情\n獲鳥豈に時俗の語を伝へんや、烟嵐故人の心を記さず"
  },
  {
   "id": "zoku-gunsho-sanjurokuban-sumodachi-shiika-0007",
   "pid": "nao-734093",
   "pages": [
    7
   ],
   "text": "古郷は浅茅か末に成はてゝ月にのこれる人のおもかけ廿三番左山寺耳界厭喧風一樹頭陀照跡月千巖右花あはれなる花のこかけの旅ねかなみねの桜の衣かさねて廿四番左於天王寺即事堂宇有面今見昔海潮充岸水連雲右於住吉社即事宮ゐせしとしもつもりのうらさひて神代おほゆる松の陰哉廿五番左秋遊山寺月輪水上空觀主風葉山中獨覺師右緑覺おく山にひとりうき世はさとりにきつねなき色を風になかめて廿六番左秋夜旅泊山重江復煙嵐路寐思寤思來梓鄕右海路秋望",
   "poems": [
    "21",
    "22",
    "23",
    "24"
   ],
   "kakikudashi": "耳界喧を厭ふ風一樹、頭陀跡を照らす月千巌\n堂宇面有りて今昔を見る、海潮岸に充ちて水雲に連なる\n山重なり江復なる煙嵐の路、寐ねても思ひ寤めても思ひて梓郷に来たる"
  },
  {
   "id": "zoku-gunsho-sanjurokuban-sumodachi-shiika-0008",
   "pid": "nao-734093",
   "pages": [
    8
   ],
   "text": "ゆく舟の跡の𛁈ら浪きえつきてうす霧のこる須磨の曙廿七番左旅劍閣梯危迷霧雨錢塘舟到宿烟嵐右きよみかた波の千里に雲きえていはしく袖によする月かけ廿八番左旅江山千里他鄕涙雲雨三年旅館腸右海邊曉月忘るなよいまはの月をかたみにて波にわかるく沖の明ふね廿九番左夏日水行渡口停船山不動湖心求泊嶋相迎右於漢河原詠之むかしきくあまの川原に尋きて跡なき水をなかむはかりそ三十番左述懷生涯不返水元意佛界非遙月在胸右別戀",
   "poems": [
    "25",
    "26",
    "27"
   ],
   "kakikudashi": "剣閣梯危ふくして霧雨に迷ひ、銭塘舟到りて烟嵐に宿る\n江山千里他郷の涙、雲雨三年旅館の腸\n渡口に船を停むれば山動かず、湖心に泊を求むれば嶋相迎ふ"
  },
  {
   "id": "zoku-gunsho-sanjurokuban-sumodachi-shiika-0009",
   "pid": "nao-734093",
   "pages": [
    9
   ],
   "text": "一わすれしの契をたのむ別かな空ゆく月の末をよそへて三十一番左述懷日々悔過最白佛時々歎運仰蒼天右戀泪せく袖におもひやあまるらん詠むる空も色かわるまて三十二番左病中偶吟病源河海朝窓水命葉芭蕉秋後風右待戀よもきふの末葉の露のきえかへりなをこの世にとまたんものかは三十三番左病中偶吟三界无安皆火宅一生有限幾風燈右憶吹風も物や思ふととひかほにうちなかむれはまつの一聲三十四番左病中偶吟來迎憑誓彌陀佛罪障異緣那落迦右夜戀",
   "poems": [
    "28",
    "29",
    "30",
    "31"
   ],
   "kakikudashi": "日々過ちを悔いて最も仏に白し、時々運を歎きて蒼天を仰ぐ\n病源は河海朝窓の水、命葉は芭蕉秋後の風\n三界安きこと無し皆火宅、一生限り有り幾風燈"
  },
  {
   "id": "zoku-gunsho-sanjurokuban-sumodachi-shiika-0010",
   "pid": "nao-734093",
   "pages": [
    10
   ],
   "text": "見し人のねくたれかみのをもかけに泪かさやるさよの手枕三十五番左春過長秋納言舊宅花尚春花留有露宅斯舊宅廢無人右述懷うつまれぬのちの名さへやとめさらんなすことなくてこのよくれなは三十六番左出現於世雲峯滿月重山夕浪發曇花苦海春右寄元動寺座主なかき夜の更行月を詠てもちかつくやみをしる人そなき奥書云此一卷白川二品經甲卿男經定筆可祕藏云々",
   "poems": [
    "32",
    "33",
    "34"
   ],
   "notes": [
    {
     "a": "此一卷",
     "n": "世尊寺先祖",
     "k": "割注"
    },
    {
     "a": "白川二品",
     "n": "号勘解小路三位",
     "k": "割注"
    },
    {
     "a": "經定",
     "n": "後改伊朝",
     "k": "割注"
    }
   ],
   "kakikudashi": "花は尚春花露を留むる有り、宅は斯れ旧宅廃れて人無し"
  }
 ],
 "poems": [
  {
   "seq": "1",
   "text": "空ばなをかすみもやらす風冴て雪気にくもる春の夜の月",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "一",
   "side": "右",
   "dai": "餘寒"
  },
  {
   "seq": "2",
   "text": "春はみなおなしさてになりはてゝ雲うそかゝれみよし野の山",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "二",
   "side": "右",
   "dai": "花"
  },
  {
   "seq": "3",
   "text": "花はみなかすみのそこに移ひて雲に炙つく小泊瀬の山",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "三",
   "side": "右",
   "dai": "花"
  },
  {
   "seq": "4",
   "text": "けふこすは庭にやあとのいとはれんとへかし人の花の盛を",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "四",
   "side": "右",
   "dai": "花下醉吟"
  },
  {
   "seq": "5",
   "text": "みぬよきておもひのこさぬ詠より昔にかずむ春の明ほの",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "五",
   "side": "右",
   "dai": "春曙"
  },
  {
   "seq": "6",
   "text": "よしの山花のふる郷跡たへてむなしき枝に春風そ吹",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "六",
   "side": "右",
   "dai": "残春"
  },
  {
   "seq": "7",
   "text": "夏の夜をやかてあかしのかち枕浪にかたふく月をしそ思ふ",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "七",
   "side": "右",
   "dai": "舟中夏月"
  },
  {
   "seq": "8",
   "text": "なくせみのはにをく露に秋かけて木陰涼しき夕暮の色",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "八",
   "side": "右",
   "dai": "蝉"
  },
  {
   "seq": "9",
   "text": "物おもはてかゝる露やは袖にをくながめさけりな秋の夕暮",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "九",
   "side": "右",
   "dai": "秋夕"
  },
  {
   "seq": "10",
   "text": "真木の戸をさてあり明に成行をいく夜の月ととふ人もなし",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "十",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "11",
   "text": "東よりけふあふ坂の関こえてみやこに出る望月の駒は",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "十一",
   "side": "",
   "dai": ""
  },
  {
   "seq": "12",
   "text": "たくへくる松のあらしやたゆむらんおのへにかへる棹鹿の聲",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "十二",
   "side": "右",
   "dai": "鹿"
  },
  {
   "seq": "13",
   "text": "山とをき門田のいなは霧晴てほなみにしつむ有明の月",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "十三",
   "side": "右",
   "dai": "秋月"
  },
  {
   "seq": "14",
   "text": "うつの山こへし昔の跡古くつたの枯葉に秋風そ吹",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "十五",
   "side": "右",
   "dai": "写"
  },
  {
   "seq": "15",
   "text": "しけき野は虫の音なから霜枯て昔の薄いまも一村",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "十六",
   "side": "右",
   "dai": "暮秋"
  },
  {
   "seq": "16",
   "text": "月やとす露の夜すから秋暮て堂のみし庭はかれのなりけり",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "十七",
   "side": "右",
   "dai": "初冬"
  },
  {
   "seq": "17",
   "text": "さひしきはいつもなかめの物なれと雲間の峯の雪の曙",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "十八",
   "side": "右",
   "dai": "冬"
  },
  {
   "seq": "18",
   "text": "雲ふかきみねの朝気のいかならん槙の戸しらむ雪のひかりに",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "十九",
   "side": "右",
   "dai": "冬朝"
  },
  {
   "seq": "19",
   "text": "麓まておなしさゝ原跡もなし深山の廬の露のしたへ",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "廿",
   "side": "右",
   "dai": "山家"
  },
  {
   "seq": "20",
   "text": "瀧の音松のひゝきもはけしきにつれなくあかす岩枕哉",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "廿一",
   "side": "右",
   "dai": "山家"
  },
  {
   "seq": "21",
   "text": "古郷は浅茅か末に成はてゝ月にのこれる人のおもかけ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "廿二",
   "side": "右",
   "dai": "旧宅"
  },
  {
   "seq": "22",
   "text": "あはれなる花のこかけの旅ねかなみねの桜の衣かさねて",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "廿三",
   "side": "右",
   "dai": "花"
  },
  {
   "seq": "23",
   "text": "宮ゐせしとしもつもりのうらさひて神代おほゆる松の陰哉",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "廿四",
   "side": "右",
   "dai": "於住吉社即事"
  },
  {
   "seq": "24",
   "text": "おく山にひとりうき世はさとりにきつねなき色を風になかめて",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "廿五",
   "side": "右",
   "dai": "緑覚"
  },
  {
   "seq": "25",
   "text": "きよみかた波の千里に雲きえていはしく袖によする月かけ",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "廿七",
   "side": "右",
   "dai": "旅"
  },
  {
   "seq": "26",
   "text": "忘るなよいまはの月をかたみにて波にわかるく沖の明ふね",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "廿八",
   "side": "右",
   "dai": "海辺暁月"
  },
  {
   "seq": "27",
   "text": "むかしきくあまの川原に尋きて跡なき水をなかむはかりそ",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "廿九",
   "side": "右",
   "dai": "於漢河原詠之"
  },
  {
   "seq": "28",
   "text": "一わすれしの契をたのむ別かな空ゆく月の末をよそへて",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "三十",
   "side": "右",
   "dai": "別恋"
  },
  {
   "seq": "29",
   "text": "泪せく袖におもひやあまるらん詠むる空も色かわるまて",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "三十一",
   "side": "右",
   "dai": "恋"
  },
  {
   "seq": "30",
   "text": "よもきふの末葉の露のきえかへりなをこの世にとまたんものかは",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "三十二",
   "side": "右",
   "dai": "待意"
  },
  {
   "seq": "31",
   "text": "吹風も物や思ふととひかほにうちなかむれはまつの一聲",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "三十三",
   "side": "右",
   "dai": "意"
  },
  {
   "seq": "32",
   "text": "見し人のねくたれかみのをもかけに泪かさやるさよの手枕",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "三十四",
   "side": "右",
   "dai": "夜忠"
  },
  {
   "seq": "33",
   "text": "うつまれぬのちの名さへやとめさらんなすことなくてこのよくれなは",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "三十五",
   "side": "右",
   "dai": "述懐"
  },
  {
   "seq": "34",
   "text": "なかき夜の更行月を詠てもちかつくやみをしる人そなき",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734093",
   "form": "短歌",
   "genre": "",
   "ban": "三十六",
   "side": "右",
   "dai": "寄元動寺座主"
  }
 ],
